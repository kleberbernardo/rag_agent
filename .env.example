# Copie para .env e preencha. O .env nunca vai para o repositorio.

# Obrigatorio
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelos
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0

# Chunking
#   characters = corta a cada CHUNK_SIZE caracteres
#   articles   = um pedaco por artigo (Art. N), caindo para characters
#                em documentos sem artigos. Melhor para texto normativo:
#                medido nesta base, 93% por caractere contra 97% por artigo.
CHUNK_STRATEGY=articles
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Teto acima do qual um artigo (ou um anexo sem artigos) e cortado tambem.
ARTICLE_MAX_CHARS=4000

# Busca
# Como os trechos sao encontrados.
#   vector = so o embedding
#   hybrid = embedding + BM25, fundidos por posicao (padrao)
SEARCH_STRATEGY=hybrid
RETRIEVAL_K=8

# Quantas buscas o agente pode fazer numa mesma pergunta. A busca vetorial
# sempre devolve os k mais proximos, entao ela nunca diz "nao achei": sem teto,
# o agente reformula indefinidamente numa pergunta que a base nao responde.
MAX_SEARCHES_PER_TURN=3

# Dominio da base de conhecimento, no idioma das respostas.
# E injetado no system prompt e na descricao da ferramenta de busca:
# apontar o agente para outro corpus e mudar esta linha, nao o codigo.
KNOWLEDGE_DOMAIN=regulacao do mercado de capitais brasileiro (resolucoes da CVM)

# Caminhos (opcional - o padrao e relativo a raiz do projeto)
# DATA_DIR=data
# LOG_DIR=logs
# COLLECTION_NAME=rag_agent_docs

# Banco. Postgres com pgvector guarda os vetores e responde a busca por
# palavra sobre as mesmas linhas. Suba com: docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# Largura da coluna de embedding, precisa bater com o modelo.
# text-embedding-3-small = 1536, text-embedding-3-large = 3072
# EMBEDDING_DIMENSIONS=1536

# Como as passagens sao encontradas.
#   hybrid = funde o embedding com a busca por palavra do Postgres (padrao)
#   vector = so o embedding
# SEARCH_STRATEGY=hybrid

# Segunda passada, que reordena o que a busca ja recuperou. Um cross-encoder
# le a pergunta e o trecho juntos, entao acerta mais e custa uma passada de
# modelo por candidato. Desligado por padrao: corrige precisao, e o que
# faltava aqui era recall.
# Exige a dependencia opcional: pip install -e ".[rerank]"
#   none          = sem segunda passada (padrao)
#   cross_encoder = modelo local, multilingue
# RERANK_STRATEGY=none
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_CANDIDATES=24

# Sessoes de conversa.
#   memory = dicionario no processo (padrao, nao exige nada rodando)
#   redis  = compartilhado entre replicas, sobrevive a restart
SESSION_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# Autenticacao da API. Vazio = aberta. Preenchido = exige o cabecalho X-API-Key.
# API_KEY=

# Resiliencia do provedor
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=60

# Tracing (opcional). Sem as duas chaves, o projeto roda igual e nada e enviado.
# Crie uma conta gratuita em https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Qual versao publicada do prompt o agente usa. Mover o label na UI do
# Langfuse e como se faz deploy ou rollback de prompt.
PROMPT_LABEL=production
PROMPT_CACHE_SECONDS=60

# Alternativa: o LangChain se instrumenta sozinho com estas variaveis.
# Nao ha codigo nosso envolvido; use uma plataforma ou a outra, nao as duas.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
